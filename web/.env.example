# Copy to web/.env.local. Leave NEXT_PUBLIC_CONSUME_CONTRACT empty to show sample figures.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONSUME_CONTRACT=
# Parent account of the testnet stand-in memes (pepe.<parent>, doge.<parent>, ...)
NEXT_PUBLIC_MEME_PARENT=
# NEAR Intents: intents.near on mainnet, or the deployed contracts/mock-intents on testnet.
# Set it to feed and redeem through Intents balances (memecoins from any chain).
NEXT_PUBLIC_INTENTS_CONTRACT=
# Optional
NEXT_PUBLIC_RPC_URL=
# Defaults to the public CONSUME repository when empty; set this for a fork.
NEXT_PUBLIC_REPO_URL=https://github.com/ethboi/consume
# Optional. A Google Analytics measurement ID (G-...). Empty: Google Analytics is not loaded.
# Vercel Analytics needs no value: it is on only when the site is built on Vercel.
NEXT_PUBLIC_GA_ID=
# Server side only. Where the Ledger reads transactions from, if not FastNEAR's public
# indexer for the network. The browser tests (e2e/) set it to a local stand-in.
CONSUME_INDEXER_URL=
